  {
   "visual": "abstrak",
   "teks": "Semua bermula dari telegraf, tahun 1844. Untuk pertama kalinya pesan berjalan lewat kabel.",
   "bab": "Era kawat dan telepon"
  },
  {
   "visual": "abstrak",
   "teks": "Dan siapa pun yang bisa menyentuh kabel itu, bisa ikut membaca isinya.",
   "bab": "Era kawat dan telepon"
  },
  {
   "visual": "abstrak",
   "teks": "Di Perang Saudara Amerika awal 1860-an, pihak-pihak yang bertikai saling menyadap saluran telegraf.",
   "bab": "Era kawat dan telepon"
  },
  {
   "visual": "abstrak",
   "teks": "Lalu telepon datang tahun 1876, dan cara menyadapnya sama sederhananya: sambung kabel cabang, lalu dengarkan.",
   "bab": "Era kawat dan telepon"
