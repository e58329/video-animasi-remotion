  },
  {
   "visual": "abstrak",
   "teks": "Lalu datang era Perang Dingin, saat alat sadap terdengar seperti film.",
   "bab": "Perang Dunia dan Perang Dingin"
  },
  {
   "visual": "abstrak",
   "teks": "Tahun 1945, anak-anak Soviet menghadiahkan patung lambang Amerika kepada duta besar di Moskow.",
   "bab": "Perang Dunia dan Perang Dingin"
  },
  {
   "visual": "abstrak",
   "teks": "Di dalamnya tersembunyi mikrofon tanpa baterai, dijuluki The Thing, yang hanya hidup saat disinari gelombang radio dari luar.",
   "bab": "Perang Dunia dan Perang Dingin"
  },
  {
   "visual": "abstrak",
   "teks": "Alat itu baru ketahuan tahun 1952, setelah bertahun-tahun mendengar tanpa disadari.",
   "bab": "Perang Dunia dan Perang Dingin"
  },
  {
   "visual": "jaringan",
   "teks": "Tahun 1955, Amerika dan Inggris menggali terowongan di bawah Berlin untuk menyadap kabel telepon militer Soviet.",
   "bab": "Perang Dunia dan Perang Dingin"
  },
  {
   "visual": "jaringan",
   "teks": "Operasinya berjalan sekitar sebelas bulan. Ironisnya, Soviet sudah tahu sejak awal dari seorang mata-mata.",
   "bab": "Perang Dunia dan Perang Dingin",
   "angka": {
    "ke": 11,
    "label": "terowongan Berlin beroperasi",
    "akhiran": " bulan"
   }
  },
  {
   "visual": "kapal-selam",
   "teks": "Tahun 1971, kapal selam Amerika diam-diam menempelkan alat sadap ke kabel telepon militer Soviet di dasar Laut Okhotsk.",
   "bab": "Perang Dunia dan Perang Dingin"
  },
  {
   "visual": "kapal-selam",
   "teks": "Rahasia itu bertahan sampai seorang pegawai badan intelijen Amerika menjualnya ke Soviet.",
   "bab": "Perang Dunia dan Perang Dingin"
  },
  {
   "visual": "radar",
   "teks": "Memasuki era seluler, muncul menara palsu yang disebut penangkap IMSI, atau stingray.",
