from faster_whisper import WhisperModel
import json

# Gunakan model "small" untuk keseimbangan akurasi dan kecepatan.
# Jika ingin lebih akurat (tapi lebih lambat), ganti ke "medium" atau "large-v3".
model = WhisperModel("small", device="cpu", compute_type="int8")

print("Sedang memproses audio...")
segments, info = model.transcribe(
    "public/audio/narasi-ardi.mp3",
    language="id",           # Bahasa Indonesia
    word_timestamps=True,    # WAJIB: untuk mendapatkan timestamp per kata
    vad_filter=True          # Filter bagian yang tidak ada suara
)

# Kumpulkan semua kata dengan timestamp-nya
words_data = []
for segment in segments:
    if segment.words:
        for word in segment.words:
            words_data.append({
                "text": word.word.strip(),
                "start": word.start,   # detik (float)
                "end": word.end        # detik (float)
            })

# Simpan ke JSON
output_path = "public/audio/narasi-whisper.json"
with open(output_path, "w", encoding="utf-8") as f:
    json.dump(words_data, f, indent=2, ensure_ascii=False)

print(f"✅ Berhasil! {len(words_data)} kata disimpan ke {output_path}")
