import React from "react";
import { AbsoluteFill, useCurrentFrame, interpolate, spring, useVideoConfig, Series, staticFile, Audio } from "remotion";

// --- KOMPONEN TEKS KARAOKE (Simulasi) ---
const SubtitleText = ({ text, startFrame }: { text: string, startFrame: number }) => {
  const frame = useCurrentFrame();
  const words = text.split(" ");
  // Simulasi timing: 15 frame per kata
  return (
    <div style={{ position: "absolute", bottom: 150, width: "100%", display: "flex", justifyContent: "center", flexWrap: "wrap", gap: "15px", padding: "0 100px", fontSize: 60, fontWeight: "bold", textShadow: "3px 3px 10px #000", zIndex: 10 }}>
      {words.map((word, i) => {
        const wordStart = startFrame + (i * 15);
        const isActive = frame >= wordStart;
        return <span key={i} style={{ color: isActive ? "#00ffcc" : "#fff", opacity: isActive ? 1 : 0.4 }}>{word}</span>
      })}
    </div>
  );
};

// --- SEGMEN 1: HOOK ---
const Hook = () => {
  const frame = useCurrentFrame();
  const rotation = interpolate(frame, [0, 240], [0, 360]);
  return (
    <AbsoluteFill style={{ backgroundColor: "#050510", justifyContent: "center", alignItems: "center" }}>
      <div style={{ width: 600, height: 600, border: "2px dashed #333", borderRadius: "50%", transform: `rotate(${rotation}deg)`, display: "flex", justifyContent: "center", alignItems: "center" }}>
        <div style={{ width: 300, height: 300, backgroundColor: "#0077b6", borderRadius: "50%", boxShadow: "0 0 50px #0077b6" }} />
      </div>
      <h1 style={{ position: "absolute", top: "20%", color: "white", fontSize: 70 }}>35.786 KM DI ATAS BUMI</h1>
      <SubtitleText text="Di ketinggian 35.786 kilometer di atas kepala kita, terdapat sebuah mesin raksasa." startFrame={0} />
    </AbsoluteFill>
  );
};

// --- SEGMEN 2: PROLOG ---
const Prolog = () => {
  return (
    <AbsoluteFill style={{ backgroundColor: "#111", justifyContent: "center", alignItems: "center" }}>
      <h1 style={{ color: "white", fontSize: 80 }}>Gravitasi & Kecepatan Lepas</h1>
      <div style={{ fontSize: 100, marginTop: 50 }}>🚀</div>
      <SubtitleText text="Untuk melepaskan diri dari gravitasi Bumi, roket harus terbang 11,2 km per detik." startFrame={0} />
    </AbsoluteFill>
  );
};

// --- SEGMEN 3: PELUNCURAN ---
const Peluncuran = () => {
  const frame = useCurrentFrame();
  const rocketY = interpolate(frame, [0, 600], [0, -1000], { extrapolateRight: "clamp" });
  return (
    <AbsoluteFill style={{ backgroundColor: "#000814" }}>
      <div style={{ position: "absolute", bottom: "20%", left: "50%", transform: `translateX(-50%) translateY(${rocketY}px)` }}>
        <div style={{ width: 60, height: 200, backgroundColor: "#eee", borderRadius: "30px 30px 0 0", borderBottom: "15px solid #ff3333" }} />
        <div style={{ width: 40, height: 150, backgroundColor: "#ff9900", margin: "0 auto", borderRadius: "0 0 50% 50%", boxShadow: "0 0 50px #ff9900" }} />
      </div>
      <h2 style={{ position: "absolute", top: "10%", width: "100%", textAlign: "center", color: "white", fontSize: 60 }}>Fase Peluncuran Roket</h2>
      <SubtitleText text="Roket melemparkan gas panas ke bawah, dan terdorong ke atas karena Hukum Newton." startFrame={0} />
    </AbsoluteFill>
  );
};

// --- SEGMEN 4: ORBIT ---
const Orbit = () => {
  const frame = useCurrentFrame();
  const rotation = interpolate(frame, [0, 600], [0, 720]);
  return (
    <AbsoluteFill style={{ backgroundColor: "#050510", justifyContent: "center", alignItems: "center" }}>
      <div style={{ position: "absolute", width: 600, height: 600, border: "2px dashed #444", borderRadius: "50%" }} />
      <div style={{ width: 300, height: 300, backgroundColor: "#0077b6", borderRadius: "50%" }} />
      <div style={{ position: "absolute", width: 600, height: 600, transform: `rotate(${rotation}deg)` }}>
        <div style={{ position: "absolute", top: -20, left: "50%", transform: "translateX(-50%)", width: 60, height: 40, backgroundColor: "#e0e0e0", borderRadius: 5 }}>
          <div style={{ position: "absolute", left: -60, top: 10, width: 60, height: 20, backgroundColor: "#4CAF50" }} />
          <div style={{ position: "absolute", right: -60, top: 10, width: 60, height: 20, backgroundColor: "#4CAF50" }} />
        </div>
      </div>
      <h2 style={{ position: "absolute", top: "10%", color: "white", fontSize: 60 }}>Jatuh Bebas Mengelilingi Bumi</h2>
      <SubtitleText text="Satelit sebenarnya sedang jatuh bebas, tapi kecepatannya membuatnya terus meleset dari Bumi." startFrame={0} />
    </AbsoluteFill>
  );
};

// --- SEGMEN 5: KENDALI BUMI ---
const Kendali = () => {
  const frame = useCurrentFrame();
  const signalScale = interpolate(frame, [0, 30, 60, 90, 120], [0, 2, 0, 2, 0], { extrapolateRight: "clamp" });
  return (
    <AbsoluteFill style={{ backgroundColor: "#111", flexDirection: "row", justifyContent: "space-between", padding: 150, alignItems: "center" }}>
      <div style={{ textAlign: "center", color: "white" }}>
        <div style={{ fontSize: 100 }}>📡</div>
        <h3>Satelit</h3>
      </div>
      <div style={{ flex: 1, height: 10, backgroundColor: "#333", position: "relative", margin: "0 50px" }}>
        <div style={{ position: "absolute", top: -15, left: "50%", width: 40, height: 40, backgroundColor: "#00ffcc", borderRadius: "50%", transform: `scale(${signalScale})`, boxShadow: "0 0 30px #00ffcc" }} />
      </div>
      <div style={{ textAlign: "center", color: "white" }}>
        <div style={{ fontSize: 100 }}>🛰️</div>
        <h3>Stasiun Bumi</h3>
      </div>
      <SubtitleText text="Stasiun bumi mengirim sinyal radio untuk mengoreksi posisi dan menyalakan thruster." startFrame={0} />
    </AbsoluteFill>
  );
};

// --- SEGMEN 6: KONSTELASI ---
const Konstelasi = () => {
  const frame = useCurrentFrame();
  return (
    <AbsoluteFill style={{ backgroundColor: "#0a0a2a", justifyContent: "center", alignItems: "center" }}>
      <div style={{ display: "flex", gap: 30 }}>
        {[1, 2, 3, 4, 5].map((i) => (
          <div key={i} style={{ width: 60, height: 60, backgroundColor: "#00ffcc", borderRadius: "50%", opacity: interpolate(frame, [i * 15, i * 15 + 15], [0, 1]) }} />
        ))}
      </div>
      <h2 style={{ color: "white", fontSize: 60, marginTop: 50 }}>Satellite Constellation</h2>
      <SubtitleText text="Ribuan satelit bekerja bersama melawan gravitasi matahari dan bulan." startFrame={0} />
    </AbsoluteFill>
  );
};

// --- SEGMEN 7: ENDING & CTA ---
const Ending = () => {
  const frame = useCurrentFrame();
  const opacity = interpolate(frame, [0, 60], [0, 1]);
  return (
    <AbsoluteFill style={{ backgroundColor: "#000", justifyContent: "center", alignItems: "center", opacity }}>
      <h1 style={{ color: "white", fontSize: 80, textAlign: "center", lineHeight: 1.5 }}>Manusia menaklukkan langit,<br />bukan untuk melarikan diri,<br />tapi untuk memahami rumahnya.</h1>
      <SubtitleText text="Jangan lupa subscribe dan bagikan video ini ke teman-teman Anda." startFrame={0} />
    </AbsoluteFill>
  );
};

// --- RANGKAIAN UTAMA ---
export const MyComp = () => {
  // Total 8 menit = 14400 frames (30 fps)
  // Kita bagi rata: 7 segmen x ~2057 frames
  return (
    <AbsoluteFill style={{ backgroundColor: "#000" }}>
      {/* Audio Placeholder (Nanti ganti dengan file MP3 asli Anda di folder public) */}
      {/* <Audio src={staticFile("audio-satelit.mp3")} /> */}
      
      <Series>
        <Series.Sequence durationInFrames={2057}><Hook /></Series.Sequence>
        <Series.Sequence durationInFrames={2057}><Prolog /></Series.Sequence>
        <Series.Sequence durationInFrames={2057}><Peluncuran /></Series.Sequence>
        <Series.Sequence durationInFrames={2057}><Orbit /></Series.Sequence>
        <Series.Sequence durationInFrames={2057}><Kendali /></Series.Sequence>
        <Series.Sequence durationInFrames={2057}><Konstelasi /></Series.Sequence>
        <Series.Sequence durationInFrames={2058}><Ending /></Series.Sequence>
      </Series>
    </AbsoluteFill>
  );
};
